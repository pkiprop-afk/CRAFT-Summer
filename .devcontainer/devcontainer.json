{
  // Opens this repository as a read-only archive of the completed study.
  //
  // Code -> Codespaces -> Create codespace on main is the whole procedure:
  // dependencies install, the app builds, and it opens in a preview pane with
  // REVIEW_MODE on. No API keys, no local install, no commands to type.
  "name": "CRAFT Benchmark (read-only review)",

  // base + the Node feature rather than a pinned node image: the feature
  // resolves the latest 22.x at build time, so this cannot break on a tag that
  // stops being published. Next 16 requires Node >= 20.9.
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },

  // The whole point: the runners are off and the API refuses writes, so nothing
  // in this environment can spend money or alter the recorded study.
  "containerEnv": {
    "REVIEW_MODE": "true"
  },

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "CRAFT Benchmark (read-only)",
      "onAutoForward": "openPreview"
    }
  },

  // Runs once, when the codespace is first created.
  "postCreateCommand": "npm ci && npm run build",

  // Runs each time the codespace is opened; the script no-ops if the server is
  // already up, so reconnecting never produces a port-in-use error.
  "postAttachCommand": "bash .devcontainer/start-review.sh",

  "customizations": {
    "vscode": {
      "settings": {
        // Defensive: this repo's history is auto-generated by GitDoc on the
        // researcher's machine. A reviewer's codespace must never commit.
        "gitdoc.enabled": false
      }
    }
  }
}
