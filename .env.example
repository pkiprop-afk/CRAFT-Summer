# API keys for the CRAFT benchmark study.
#
# NOT NEEDED TO BROWSE RESULTS. Set REVIEW_MODE=true (see below) and every
# stored result, the task registry, the judge-agreement figures, the paper, and
# the CSV exports render from data/*.json with all three keys left blank.
#
# Keys are only required to RUN the study — generation and evaluation. Running
# it makes paid provider calls.
#
# Copy this file to .env.local and fill in the values. .env.local is gitignored
# and must stay that way: it is the ONLY place in this repository where a
# credential belongs. Nothing else here is safe to paste a key into — the repo
# is a study record and everything in it is intended to be readable.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Read-only archive mode. Set to true to serve the completed study with the
# runners disabled in the interface and refused (403) at the API, so nothing
# can be generated or overwritten. Any other value, or unset, runs normally.
REVIEW_MODE=false
